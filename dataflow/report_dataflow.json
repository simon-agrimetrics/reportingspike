{
	"name": "report_dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ckan_transform",
						"type": "DatasetReference"
					},
					"name": "ckan"
				},
				{
					"dataset": {
						"referenceName": "wms_transform",
						"type": "DatasetReference"
					},
					"name": "wms"
				},
				{
					"dataset": {
						"referenceName": "wfs_transform",
						"type": "DatasetReference"
					},
					"name": "wfs"
				},
				{
					"dataset": {
						"referenceName": "ogc_transform",
						"type": "DatasetReference"
					},
					"name": "ogc"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "report_transform",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "unpivot1"
				},
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "join2"
				},
				{
					"name": "select3"
				},
				{
					"name": "join3"
				},
				{
					"name": "select4"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select5"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     startDate as string,",
				"     endDate as string",
				"}",
				"source(output(",
				"          id as string,",
				"          wfs as string,",
				"          wms as string,",
				"          ogc as string,",
				"          wms_full as string,",
				"          wfs_full as string,",
				"          ogc_full as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['transform/ckan-out*.csv']) ~> ckan",
				"source(output(",
				"          date as date,",
				"          urlPath as string,",
				"          count as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:[(concat('transform/', 'wms-', $startDate, '-', $endDate, '-', '*', '.csv'))]) ~> wms",
				"source(output(",
				"          date as date,",
				"          urlPath as string,",
				"          count as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:[(concat('transform/', 'wfs-', $startDate, '-', $endDate, '-', '*', '.csv'))]) ~> wfs",
				"source(output(",
				"          date as date,",
				"          urlPath as string,",
				"          count as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:[(concat('transform/', 'ogc-', $startDate, '-', $endDate, '-', '*', '.csv'))]) ~> ogc",
				"select1 unpivot(output(",
				"          url as string,",
				"          value as string",
				"     ),",
				"     ungroupBy(id),",
				"     pivotValues: ['wfs', 'wms', 'ogc'],",
				"     lateral: false,",
				"     ignoreNullPivots: true) ~> unpivot1",
				"ckan select(mapColumn(",
				"          id,",
				"          wfs,",
				"          wms,",
				"          ogc",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"unpivot1, wms join(value == urlPath,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          id,",
				"          value,",
				"          wms_date = date,",
				"          wms_urlPath = urlPath,",
				"          wms_count = count",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2, wfs join(value == urlPath,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2 select(mapColumn(",
				"          id,",
				"          value,",
				"          wms_date,",
				"          wms_urlPath,",
				"          wms_count,",
				"          wfs_date = date,",
				"          wfs_urlPath = urlPath,",
				"          wfs_count = count",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select3, ogc join(value == urlPath,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join3 select(mapColumn(",
				"          id,",
				"          value,",
				"          wms_date,",
				"          wms_urlPath,",
				"          wms_count,",
				"          wfs_date,",
				"          wfs_urlPath,",
				"          wfs_count,",
				"          ogc_date = date,",
				"          ogc_urlPath = urlPath,",
				"          ogc_count = count",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 derive(url = coalesce(coalesce(wfs_urlPath, wms_urlPath), ogc_urlPath),",
				"          count = coalesce(coalesce(wfs_count, wms_count), ogc_count),",
				"          date = coalesce(coalesce(wfs_date, wms_date), ogc_date)) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          id,",
				"          url,",
				"          count,",
				"          date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"select5 filter(!isNull(url)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     filePattern:(concat('report-', $startDate, '-', $endDate, '.csv')),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}