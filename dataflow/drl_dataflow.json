{
	"name": "drl_dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "elasticextracts"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "drl_transform",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "flatten1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"parameters{",
				"     startDate as string,",
				"     endDate as string",
				"}",
				"source(output(",
				"          {_shards} as (failed as boolean, skipped as short, successful as short, total as short),",
				"          hits as (hits as ({_id} as string, {_index} as string, {_score} as string, {_source} as ({@timestamp} as string, agent as (ephemeral_id as string, hostname as string, id as string, type as string, version as string), ecs as (version as string), host as (name as string), input as (type as string), kubernetes as (container as (image as string, name as string), labels as (app as string, {pod-template-hash} as string), namespace as string, namespace_labels as ({kubernetes_io/metadata_name} as string), namespace_uid as string, node as (name as string), pod as (name as string, uid as string), replicaset as (name as string)), message as string, stream as string, tags as string[]), sort as long[])[], max_score as string, total as (relation as string, value as short)),",
				"          timed_out as boolean,",
				"          took as integer",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'json',",
				"     fileSystem: 'report-data',",
				"     documentForm: 'singleDocument',",
				"     wildcardPaths:['drl-hits/*.json']) ~> elasticextracts",
				"elasticextracts foldDown(unroll(hits.hits, hits.hits),",
				"     mapColumn(",
				"          timestamp = hits.hits.{_source}.{@timestamp},",
				"          message = hits.hits.{_source}.message",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"flatten1 derive(month = toDate(timestamp, 'yyyy-M'),",
				"          timestamp = timestamp,",
				"          referer = regexExtract(message, `^(\\S*).*\\[(.*)\\]\\s\"(\\S*)\\s(\\S*)\\s([^\"]*)\"\\s(\\S*)\\s(\\S*)\\s(\\S*)\\s\"([^\"]*)\"\\s\"([^\"]*)\" \"([^\"]*)\"$`, 9)) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(month),",
				"     hits = count()) ~> aggregate1",
				"derivedColumn2 sort(asc(month, true)) ~> sort1",
				"aggregate1 derive(month = regexExtract(toString(month), `^(.*-.*)-.*$`, 1)) ~> derivedColumn2",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['drl-hits-report.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}